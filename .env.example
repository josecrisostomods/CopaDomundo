VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apenas no servidor/Vercel. Nunca exponha no frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Provider recomendado para comecar: football-data.org.
# Se a chave for secreta, use apenas em ambiente serverless da Vercel.
FOOTBALL_DATA_TOKEN=

# Alternativa: API-Football / API-Sports.
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# Chat público e assistente administrativo. Configure apenas no servidor/Vercel.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# UUID do único perfil autorizado a usar o modo administrativo do chatbot.
# Sem esse valor, o chatbot funciona somente no modo público.
ADMIN_CHAT_USER_ID=
